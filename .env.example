# Production PostgreSQL connection.
# Set these values in the deployment environment; do not commit real credentials.
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://localhost:5432/choir
R2DBC_URL=r2dbc:postgresql://localhost:5432/choir
DATABASE_USERNAME=change_me
DATABASE_PASSWORD=change_me

# Registration and verification email (disabled by default).
# Set real values only in the deployment environment; do not commit credentials.
CHOIR_AUTH_REGISTRATION_ENABLED=false
CHOIR_AUTH_VERIFICATION_URL_BASE=https://app.example.org/change_me
CHOIR_MAIL_ENABLED=false
CHOIR_MAIL_FROM=change_me@example.org
SPRING_MAIL_HOST=change_me
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=change_me
SPRING_MAIL_PASSWORD=change_me
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
